# ==============================================
# CHAINSCOPE BACKEND ENVIRONMENT VARIABLES
# ==============================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blockchain_indexer
DB_USER=user
DB_PASSWORD=password

# Indexing & Real-time Flags
# Set to 'true' to enable background historical indexing
ENABLE_ETH_INDEXER=true
ENABLE_BTC_INDEXER=true

# RPC Endpoints (Backend Only)
# Uses public endpoints by default. Replace with Infura/Alchemy/Quicknode/Localhost for production stability.

# Ethereum RPC
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Alternative: https://mainnet.infura.io/v3/YOUR_ID

# Bitcoin RPC
BTC_RPC_URL=https://bitcoin-rpc.publicnode.com
# Note: For full indexing, a local node (http://localhost:8332) is best. 
# Public endpoints often restrict 'getblock' verbosity.

# WebSocket Feeds (Backend Connects Here)
WS_ETH_URL=wss://ethereum-rpc.publicnode.com
WS_BTC_URL=wss://ws.blockchain.info/inv

# Security
JWT_SECRET=super_secret_chainscope_key_2026
API_KEY=internal_system_key

# Logging
LOG_LEVEL=info
