# ==============================================
# CHAINSCOPE FRONTEND ENVIRONMENT VARIABLES
# ==============================================

# Application Settings
NEXT_PUBLIC_APP_NAME=LuminaChain
NEXT_PUBLIC_APP_VERSION=1.0.0

# Backend Connection
# The frontend connects ONLY to this URL for API and WebSockets
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Feature Flags
NEXT_PUBLIC_ENABLE_WALLET=true
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_SHOW_SYSTEM_HEALTH=true

# External Links (Display Only)
NEXT_PUBLIC_BTC_EXPLORER=https://mempool.space
NEXT_PUBLIC_ETH_EXPLORER=https://etherscan.io
